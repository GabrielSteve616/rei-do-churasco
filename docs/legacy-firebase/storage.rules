rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /groups/{groupId}/{allPaths=**} {
      allow read: if request.auth != null && firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberIds.hasAny([request.auth.uid]);
      allow write: if request.auth != null && firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberIds.hasAny([request.auth.uid]);
    }
  }
}
